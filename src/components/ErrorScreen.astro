---
const {
  code,
  eyebrow,
  title,
  description,
  primaryHref = '/',
  primaryLabel = '홈으로 돌아가기',
  secondaryHref = '/contact/',
  secondaryLabel = '상담 문의하기'
} = Astro.props;
---

<section class="error-screen">
  <div class="wrap error-inner">
    <span class="eyebrow">{eyebrow}</span>
    <p class="error-code">{code}</p>
    <h1>{title}</h1>
    <p class="error-description">{description}</p>
    <div class="error-actions">
      <a class="error-primary" href={primaryHref}>{primaryLabel}</a>
      <a class="error-secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .error-screen {
    min-height: calc(100vh - 84px);
    display: flex;
    align-items: center;
    background: var(--mist);
    padding: 96px 0;
  }

  .error-inner {
    max-width: 760px;
  }

  .error-code {
    font: 800 clamp(72px, 14vw, 168px) / 0.9 'Manrope';
    letter-spacing: 0;
    color: var(--deep);
    margin: 28px 0 18px;
  }

  h1 {
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.18;
    letter-spacing: 0;
    margin: 0 0 20px;
  }

  .error-description {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
    font-size: 18px;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .error-primary,
  .error-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 170px;
    padding: 15px 22px;
    font-weight: 700;
  }

  .error-primary {
    background: var(--deep);
    color: white;
  }

  .error-secondary {
    border: 1px solid #b8c2bf;
    color: var(--deep);
  }

  @media (max-width: 560px) {
    .error-screen {
      padding: 72px 0;
    }

    .error-primary,
    .error-secondary {
      width: 100%;
    }
  }
</style>

---
import ContactForm from './ContactForm.astro';
import SpaceGallery from './SpaceGallery.astro';
import ProjectSteps from './ProjectSteps.astro';
import { comparisonVersions } from '../data/comparison';

const services = [
  ['01', '가구 선정과 제안', '요구 규격과 예산에 맞춰 브랜드별 제품부터 맞춤 제작까지 비교하고 제안합니다.'],
  ['02', '레이아웃과 3D', '좌석 수, 이동 동선, 수납을 함께 검토하고 배치안을 눈으로 확인합니다.'],
  ['03', '납품부터 사후관리', '반입과 설치 일정을 조율하고, 검수와 이후 유지관리까지 이어갑니다.'],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="공공기관과 기업을 위한 가구 제안, 공간 배치, 납품과 설치. 비타스페이스와 더 나은 일터를 만드세요." />
    <title>VITASPACE — 공공의 공간을 더 나은 일터로 | A안</title>
  </head>
  <body>
    <a class="skip" href="#main">본문 바로가기</a>
    <header class="header">
      <a class="logo" href="/compare/a/" aria-label="비타스페이스 A안 홈">vita<span>space</span><i aria-hidden="true"></i></a>
      <nav class="desktop-nav" aria-label="주요 메뉴">
        <a href="#works">납품사례</a><a href="#brands">취급 브랜드</a><a href="#process">진행 과정</a>
      </nav>
      <a class="header-contact" href="#contact">상담 문의</a>
      <details class="mobile-nav">
        <summary aria-label="메뉴 열기">메뉴 <span aria-hidden="true">+</span></summary>
        <nav aria-label="모바일 주요 메뉴"><a href="#works">납품사례</a><a href="#brands">취급 브랜드</a><a href="#process">진행 과정</a><a href="#contact">상담 문의</a></nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-heading inset">
          <div><p class="eyebrow"><span></span> FURNITURE. SPACE. PEOPLE.</p><h1 id="hero-title">공공의 공간을<br />더 나은 <span class="accent-word">일터로<span class="period">.</span></span></h1></div>
          <div class="hero-note"><p>가구를 고르는 일부터<br />공간을 완성하는 일까지.</p><p class="muted">기관과 기업의 목적에 맞춰<br />제안하고, 배치하고, 설치합니다.</p></div>
        </div>
        <figure class="hero-photo"><img src="/media/delivery/samdong-1.jpg" alt="책상과 수납, 회의 공간이 함께 배치된 실제 납품 현장" fetchpriority="high" width="1600" height="1000" /><figcaption><span>SPACE FOR BETTER WORK</span><span>일하는 사람을 중심에 두고.</span></figcaption></figure>
      </section>

      <section class="services section inset" id="services">
        <div class="section-heading"><p class="eyebrow">WHAT WE DO</p><div><h2>필요한 가구에서,<br />잘 쓰이는 공간까지.</h2><p class="section-copy">공간마다 필요한 답은 다릅니다.<br />조건에 맞는 제품과 배치, 실행 방법을 함께 찾습니다.</p></div></div>
        <div class="service-grid">{services.map(([num, title, description]) => <article><span class="number">{num}</span><h3>{title}</h3><p>{description}</p></article>)}</div>
      </section>

      <SpaceGallery />

      <section class="brands section inset" id="brands"><div class="brands-heading"><p class="eyebrow">BRAND SELECTION</p><h2>브랜드는 다양하게.<br />선택은 공간에 맞게.</h2><p class="section-copy">품질과 디자인, 예산과 납기까지.<br />필요한 기준으로 비교하고 조합합니다.</p></div><div class="brand-grid" aria-label="취급 브랜드">{['FURSYS', 'DESKER', 'SIDIZ', 'BESTUHL', 'PATRA', 'ILOOM', 'ALLOSO', 'CUSTOM MADE'].map(brand => <span>{brand}</span>)}</div></section>

      <ProjectSteps showArrow={false} showLink={false} />

      <section class="contact section inset" id="contact"><div class="contact-copy"><p class="eyebrow">LET’S TALK ABOUT YOUR SPACE</p><h2>어떤 일터를<br />생각하고 계세요<span>?</span></h2><p>새로운 사무실도, 필요한 가구 한 품목도.<br />지금 고민하고 있는 것부터 알려주세요.</p><div class="contact-note"><p>도면이 없어도 괜찮습니다.<br /><small>예상 인원, 공간 규모, 희망 일정을 알려주시면<br />필요한 정보부터 함께 정리합니다.</small></p></div></div><div class="contact-panel"><h3>프로젝트 상담</h3><ContactForm variant="home" className="h-form" submitLabel="상담 신청하기" /></div></section>
    </main>

    <footer class="footer inset"><a class="logo" href="/compare/a/">vita<span>space</span><i aria-hidden="true"></i></a><p>가구와 공간, 그리고 사람을 잇습니다.</p><a href="/about/">비타스페이스 소개</a><small>© VITASPACE</small></footer>


    <aside class="compare" aria-label="첫 화면 시안 비교">{comparisonVersions.map((item) => <a href={`/compare/${item.id}/`} aria-current={item.id === 'a' ? 'page' : undefined}>{item.label}</a>)}</aside>
  </body>
</html>

<script>
  const comparison = document.querySelector<HTMLElement>('.compare');
  if (comparison) comparison.scrollLeft = comparison.scrollWidth;
  document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => {
    document.querySelector<HTMLDetailsElement>('.mobile-nav')!.open = false;
  }));
</script>

<style>
  :global(html:has(.hero-heading)) { scroll-behavior: smooth; scroll-padding-top: 110px; }
  :global(body:has(.hero-heading)) { margin: 0; color: #171717; background: #ffffff; font-family: 'Pretendard', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; word-break: keep-all; --ink: #171717; --deep: #171717; --muted: #666666; --h-header-height: 80px; }
  * { box-sizing: border-box; }
  a { color: inherit; text-decoration: none; }
  button, input, select, textarea { font: inherit; }
  button { cursor: pointer; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #171717; outline-offset: 5px; }
  p, h1, h2, h3, figure { margin: 0; }
  .inset { padding-left: clamp(24px, 4.4vw, 80px); padding-right: clamp(24px, 4.4vw, 80px); }
  .header { height: var(--h-header-height); padding: 0 4.4vw; display: flex; align-items: center; gap: 40px; background: #ffffff; border-bottom: 1px solid #e5e5e5; position: sticky; top: 0; z-index: 20; }
  .logo { display: inline-flex; align-items: baseline; font-family: Arial, sans-serif; font-size: 34px; letter-spacing: -1.8px; font-weight: 700; white-space: nowrap; }
  .logo span { font-weight: 400; }
  .logo i { width: 8px; height: 8px; background: #171717; border-radius: 50%; margin-left: 5px; }
  .desktop-nav { display: flex; gap: 36px; margin-left: auto; font-size: 14px; font-weight: 600; }
  .desktop-nav a:hover { color: #666666; }
  .header-contact { display: flex; justify-content: center; text-align: center; min-width: 140px; align-items: center; background: #171717; color: white; padding: 15px 22px; border-radius: 8px; font-size: 14px; }
  .header-contact:hover { background: #333333; }
  .mobile-nav { display: none; }
  .skip { position: fixed; left: 20px; top: -100px; background: white; z-index: 100; padding: 12px; }
  .skip:focus { top: 10px; }
  .hero { height: calc(100svh - var(--h-header-height) - 52px); display: grid; grid-template-rows: auto minmax(0, 1fr); padding-bottom: 52px; background: #ffffff; }
  .hero-heading { display: grid; grid-template-columns: 1fr 270px; gap: 32px; align-items: end; padding-top: clamp(22px, 3.8svh, 42px); padding-bottom: clamp(20px, 3svh, 32px); }
  .eyebrow { font: 600 11px/1.4 Arial, sans-serif; letter-spacing: .13em; margin-bottom: 26px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 9px; }
  .eyebrow > span { width: 6px; height: 6px; border-radius: 50%; background: #171717; }
  h1 { font-size: clamp(40px, min(5.3vw, 8svh), 88px); font-weight: 600; letter-spacing: -.065em; line-height: 1.16; }
  .accent-word { color: inherit; }
  .period { color: #171717; }
  .hero-note { padding-bottom: 0; font-size: 17px; line-height: 1.65; }
  .hero-note .muted { margin-top: 10px; font-size: 13px; color: #666666; }
  .hero .eyebrow { margin-bottom: 18px; }
  .hero-photo { margin: 0 24px; min-height: 0; height: 100%; position: relative; overflow: hidden; border-radius: 20px; }
  .hero-photo > img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 50% 66%; }
  .hero-photo figcaption { position: absolute; inset: auto 0 0; padding: 50px 32px 25px; display: flex; justify-content: space-between; color: white; background: linear-gradient(transparent, #00000088); font-size: 13px; }
  .hero-photo figcaption span:first-child { font: 11px Arial, sans-serif; letter-spacing: .14em; }
  .section { padding-top: 120px; padding-bottom: 120px; }
  .services.section { padding-top: 60px; background: #f5f5f5; }
  h2 { font-size: clamp(32px, 3.6vw, 56px); line-height: 1.3; letter-spacing: -.055em; font-weight: 500; }
  .section-heading { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; }
  .section-copy { font-size: 15px; color: #666666; line-height: 1.8; }
  .section-heading .section-copy { margin-top: 24px; }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; margin-top: 64px; }
  .service-grid article { border-top: 1px solid #d6d6d6; padding-top: 25px; }
  .number { font: 13px Arial, sans-serif; color: #666666; }
  .service-grid h3 { font-size: 24px; font-weight: 500; letter-spacing: -.045em; margin: 36px 0 16px; }
  .service-grid p { color: #666666; line-height: 1.8; font-size: 15px; max-width: 340px; }
  .brands { background: #f5f5f5; display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: center; }
  .brands .section-copy { margin: 25px 0 20px; }
  .brand-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
  .brand-grid span { height: 106px; display: grid; place-items: center; font: 600 clamp(18px, 2.1vw, 30px)/1 Arial, sans-serif; letter-spacing: -.04em; border-bottom: 1px solid #e5e5e5; }
  .brand-grid span:nth-last-child(-n+2) { border-bottom: 0; }
  .brand-grid span:last-child { font-size: 18px; letter-spacing: .03em; font-weight: 400; }
  .contact { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 7vw; background: #f5f5f5; color: #171717; border-top: 1px solid #e5e5e5; }
  .contact .eyebrow { color: #666666; }
  .contact h2 { font-size: clamp(36px, 4.3vw, 64px); }
  .contact h2 > span { color: inherit; }
  .contact-copy > p:not(.eyebrow) { margin-top: 28px; font-size: 15px; line-height: 1.85; color: #555555; }
  .contact-note { display: flex; gap: 24px; border-top: 1px solid #dddddd; margin-top: 65px; padding-top: 28px; line-height: 1.8; font-size: 15px; }
  .contact-note small { font-size: 13px; color: #666666; display: inline-block; margin-top: 8px; }
  .contact-panel { padding: 34px; background: #ffffff; color: #171717; border-radius: 20px; }
  .contact-panel > h3 { font-size: 23px; font-weight: 500; margin: 0 0 25px; }
  .contact-panel :global(.h-form) { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .contact-panel :global(.field) { min-width: 0; width: 100%; border: 1px solid #d8d8d8; border-radius: 8px; padding: 15px 12px; color: #171717; background: #fff; font-size: 14px; line-height: 1.4; box-sizing: border-box; }
  .contact-panel :global(input), .contact-panel :global(select), .contact-panel :global(textarea) { font-family: inherit; font-size: 14px; }
  .contact-panel :global(.wide) { grid-column: 1 / -1; }
  .contact-panel :global(textarea) { resize: vertical; min-height: 100px; }
  .contact-panel :global(.privacy) { grid-column: 1 / -1; display: flex; align-items: start; gap: 6px; font-size: 11px; line-height: 1.6; color: #666666; margin-top: 6px; }
  .contact-panel :global(.privacy input) { accent-color: #171717; margin: 2px 0 0; }
  .contact-panel :global(button[type=submit]) { grid-column: 1 / -1; border: 0; border-radius: 8px; padding: 18px; background: #171717; color: #ffffff; font-family: inherit; font-size: 15px; font-weight: 600; line-height: 1.4; cursor: pointer; margin-top: 8px; }
  .contact-panel :global(.success) { display: none; grid-column: 1 / -1; font-size: 14px; line-height: 1.6; }
  .footer { display: flex; flex-wrap: wrap; align-items: center; gap: 30px; padding-top: 50px; padding-bottom: 100px; }
  .footer p { font-size: 13px; color: #666666; }
  .footer > a:not(.logo) { margin-left: auto; font-size: 13px; }
  .footer small { width: 100%; color: #666666; font: 10px Arial; letter-spacing: .08em; }
  .photo-label { font-size: 13px; text-align: center; }
  .compare { position: fixed; bottom: max(16px, env(safe-area-inset-bottom)); right: max(16px, env(safe-area-inset-right)); max-width: calc(100vw - 24px); overflow-x: auto; z-index: 101; display: flex; gap: 2px; padding: 4px; border: 1px solid #d0d0d0; border-radius: 32px; background: white; color: #171717; box-shadow: 0 3px 16px #00000024; }
  .compare a { display: grid; place-items: center; min-height: 40px; white-space: nowrap; padding: 0 16px; border-radius: 24px; font: 600 14px/1.2 system-ui, sans-serif; }
  .compare a[aria-current] { background: #171717; color: white; }
  @media (max-width: 1000px) {
    .header { height: 80px; gap: 25px; }
    .desktop-nav { gap: 22px; }
    .hero-heading { grid-template-columns: 1fr 210px; }
    .hero-note { font-size: 17px; }
    .section { padding-top: 85px; padding-bottom: 85px; }
    .services.section { padding-top: 42.5px; }
    .brands { gap: 40px; }
    .contact { gap: 32px; }
    .contact-panel { padding: 24px; }
  }
  @media (max-width: 720px) {
    :global(html:has(.hero-heading)) { scroll-padding-top: 84px; }
    :global(body:has(.hero-heading)) { --h-header-height: 72px; }
    .header { padding: 0 24px; height: var(--h-header-height); gap: 18px; }
    .logo { font-size: 28px; }
    .logo i { width: 6px; height: 6px; }
    .desktop-nav { display: none; }
    .header-contact { min-width: 0; min-height: 44px; margin-left: auto; background: none; color: #171717; padding: 0; gap: 8px; font-size: 12px; }
    .header-contact:hover { background: none; }
    .mobile-nav { display: block; font-size: 12px; }
    .mobile-nav summary { cursor: pointer; list-style: none; padding: 12px 0 12px 12px; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .mobile-nav summary span { margin-left: 8px; }
    .mobile-nav nav { position: absolute; top: 71px; left: 0; right: 0; padding: 12px 24px 24px; display: grid; background: #ffffff; box-shadow: 0 16px 20px #00000015; }
    .mobile-nav nav a { padding: 17px 0; font-size: 22px; border-top: 1px solid #e5e5e5; }
    .hero-heading { padding-top: clamp(18px, 3.2svh, 32px); padding-bottom: 24px; grid-template-columns: 1fr; gap: 20px; }
    .eyebrow { font-size: 10px; margin-bottom: 22px; }
    h1 { font-size: clamp(34px, min(9.8vw, 6svh), 58px); letter-spacing: -.065em; line-height: 1.22; }
    .hero-note { display: grid; grid-template-columns: 1fr; gap: 12px; padding-bottom: 0; align-items: center; font-size: 14px; }
    .hero-note .muted { display: none; }
    .hero-photo { margin: 0 12px; height: 100%; }
    .hero-photo figcaption { padding: 45px 16px 20px; font-size: 11px; }
    .hero-photo figcaption span:first-child { font-size: 8px; letter-spacing: .07em; }
    .section { padding-top: 70px; padding-bottom: 70px; }
    .services.section { padding-top: 35px; }
    h2 { font-size: 34px; }
    .section-heading { grid-template-columns: 1fr; gap: 0; }
    .section-copy { font-size: 14px; }
    .service-grid { grid-template-columns: 1fr; gap: 32px; margin-top: 40px; }
    .service-grid article { display: grid; grid-template-columns: 35px 1fr; gap: 10px 12px; padding-top: 20px; }
    .service-grid h3 { margin: 0; font-size: 22px; }
    .number { padding-top: 5px; }
    .service-grid p { grid-column: 2; max-width: none; font-size: 14px; }
    .brands { grid-template-columns: 1fr; gap: 40px; }
    .brand-grid span { height: 85px; font-size: 25px; }
    .contact { grid-template-columns: 1fr; gap: 40px; }
    .contact h2 { font-size: 40px; }
    .contact-note { margin-top: 30px; }
    .contact-panel { padding: 24px 20px; }
    .contact-panel :global(.h-form) { gap: 10px; }
    .contact-panel :global(.field) { padding: 14px 9px; font-size: 16px; }
    .footer { gap: 24px; padding-top: 38px; padding-bottom: 145px; }
    .footer p { width: 100%; }
    .footer > a:not(.logo) { margin-left: 0; }
  }
  @media (max-width: 640px) { .compare { bottom: max(16px, env(safe-area-inset-bottom)); } .compare a { padding: 0 10px; font-size: 12px; } }
  @media (max-height: 560px) and (min-width: 721px) {
    .hero-heading { padding-top: 14px; padding-bottom: 14px; }
    .hero .eyebrow { margin-bottom: 10px; }
    .hero-note .muted { display: none; }
  }
  @media (max-height: 600px) and (max-width: 720px) {
    .hero-heading { padding-top: 14px; padding-bottom: 16px; gap: 14px; }
    .hero-note > p { display: none; }
    .hero-note { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html:has(.hero-heading)) { scroll-behavior: auto; } }
</style>

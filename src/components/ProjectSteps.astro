---
const { id = 'process', showArrow = true, showLink = true } = Astro.props;
const steps = [
  ['상담', '인원 · 예산 · 일정', '필요한 품목과 공간의 조건을 함께 정리합니다.'],
  ['실측', '공간 · 반입 동선', '배치할 공간과 현장의 설치 조건을 확인합니다.'],
  ['제안', '배치 · 3D · 제품', '배치안과 제품 조합을 보고 방향을 결정합니다.'],
  ['발주', '규격 · 견적 · 납기', '제품 사양과 비용, 납품 일정을 확정합니다.'],
  ['설치', '현장 검수 · 사후관리', '반입과 설치를 진행하고 사용 상태를 확인합니다.'],
];
---
<section class="project-steps" id={id} aria-labelledby={`${id}-title`}>
  <div class="steps-heading"><div><p class="kicker">FROM PLAN TO PLACE</p><h2 id={`${id}-title`}>어떻게 시작하고,<br />무엇을 확인할까요.</h2></div><div><p>가구를 선택하는 순간부터 설치 이후까지.<br />단계마다 함께 확인하며 진행합니다.</p>{showLink && <a href="/process/">진행 과정 자세히 보기 {showArrow && <span aria-hidden="true">↗</span>}</a>}</div></div>
  <ol>{steps.map(([title,check,description],index)=><li><span class="step-number">0{index+1}</span><h3>{title}</h3><strong>{check}</strong><p>{description}</p></li>)}</ol>
</section>
<style>
  .project-steps{padding:110px clamp(24px,4.4vw,80px);background:#fff;color:#171717;border-top:1px solid #e3e3e3;scroll-margin-top:0;font-family:'Pretendard','Apple SD Gothic Neo',sans-serif}
  *{box-sizing:border-box}p,h2,h3{margin:0}.steps-heading{display:flex;justify-content:space-between;align-items:end;gap:40px}.kicker{font:11px/1.4 Arial,sans-serif;letter-spacing:.13em;margin-bottom:24px}h2{font-size:clamp(32px,3.6vw,54px);font-weight:500;line-height:1.3;letter-spacing:-.055em}.steps-heading>div>p:not(.kicker){font-size:15px;line-height:1.85;color:#666}.steps-heading a{display:inline-flex;gap:32px;color:inherit;text-decoration:none;border-bottom:1px solid #999;padding:14px 0;margin-top:12px;font-size:14px}ol{display:grid;grid-template-columns:repeat(5,1fr);gap:28px;list-style:none;padding:0;margin:64px 0 0}li{border-top:1px solid #aaa;padding-top:20px}.step-number{font:12px Arial;color:#777}h3{font-size:26px;font-weight:500;letter-spacing:-.04em;margin:28px 0 20px}strong{display:block;font-size:13px;font-weight:500}li p{color:#666;font-size:13px;line-height:1.8;margin-top:12px;max-width:18em}a:focus-visible{outline:2px solid;outline-offset:5px}
  @media(max-width:760px){.project-steps{padding-top:72px;padding-bottom:72px}.steps-heading{display:block}.steps-heading>div+div{margin-top:24px}ol{grid-template-columns:1fr;gap:0;margin-top:36px}li{display:grid;grid-template-columns:28px 64px 1fr;gap:8px 14px;padding:22px 0}.step-number{padding-top:7px}h3{font-size:22px;margin:0;grid-row:span 2}strong{padding-top:4px;font-size:12px}li p{grid-column:3;margin:0;max-width:none;font-size:12px}}
</style>

---
import ProjectSteps from './ProjectSteps.astro';
import ContactForm from './ContactForm.astro';
const services = [
  {num:'01',title:'어떻게 일하는지부터.',subtitle:'공간 분석 · 레이아웃 · 3D',text:'인원과 업무 방식, 좌석과 이동 동선을 함께 살핍니다. 배치안을 눈으로 확인하고 공간에 맞는 구성을 찾습니다.',image:'/media/delivery/samdong-1.jpg',alt:'좌석과 수납이 배치된 업무공간',link:'/process/',label:'배치와 진행 과정'},
  {num:'02',title:'공간에 맞는 선택.',subtitle:'브랜드 비교 · 규격 · 예산',text:'가구의 크기와 쓰임, 예산과 납기까지. 여러 브랜드와 맞춤 제작을 비교해 필요한 제품을 제안합니다.',image:'/media/experiments/lounge-original.png',alt:'화이트 소파와 테이블이 놓인 휴게공간',link:'#g-brands',label:'취급 브랜드'},
  {num:'03',title:'쓰이는 순간까지.',subtitle:'납품 · 설치 · 사후관리',text:'반입 동선과 현장 일정을 확인하고 설치와 검수를 진행합니다. 공간을 완성한 이후의 사용까지 함께 생각합니다.',image:'/media/delivery/samdong-3.jpg',alt:'긴 테이블과 의자가 놓인 회의공간',link:'#g-process',label:'납품과 설치 과정'},
];
---
<nav class="detail-nav" aria-label="페이지 내 메뉴"><a href="#g-services">가구와 공간</a><a href="#g-brands">브랜드</a><a href="#g-process">진행 과정</a><a href="#g-contact">상담 문의 <span aria-hidden="true">↗</span></a></nav>
<section class="word-services" id="g-services" aria-label="가구와 공간 서비스">
  {services.map(service=><article><figure><img src={service.image} alt={service.alt} width="1536" height="1024" loading="lazy"/></figure><div><p class="kicker">{service.num} / FURNITURE & SPACE</p><h2>{service.title}</h2><h3>{service.subtitle}</h3><p class="description">{service.text}</p><a href={service.link}>{service.label} <span aria-hidden="true">↗</span></a></div></article>)}
</section>
<section class="word-brands" id="g-brands"><div><p class="kicker">BRAND SELECTION</p><h2>브랜드는 다양하게.<br />선택은 공간에 맞게.</h2><p>품질과 디자인, 예산과 납기까지.<br />필요한 기준으로 비교하고 조합합니다.</p><a href="/brands/">취급 브랜드 알아보기 <span aria-hidden="true">↗</span></a></div><div class="brand-list" aria-label="취급 브랜드">{['FURSYS','DESKER','SIDIZ','BESTUHL','PATRA','ILOOM','ALLOSO','CUSTOM MADE'].map(brand=><span>{brand}</span>)}</div></section>
<ProjectSteps id="g-process"/>
<section class="word-contact" id="g-contact"><div><p class="kicker">LET’S TALK ABOUT YOUR SPACE</p><h2>어떤 일터를<br />생각하고 계세요?</h2><p>새로운 사무실도, 필요한 가구 한 품목도.<br />지금 고민하고 있는 것부터 알려주세요.</p><div class="contact-note"><span aria-hidden="true">↗</span><p>도면이 없어도 괜찮습니다.<small>예상 인원, 공간 규모, 희망 일정을 알려주시면<br />필요한 정보부터 함께 정리합니다.</small></p></div></div><div class="inquiry-panel"><h3>프로젝트 상담</h3><ContactForm variant="home" className="word-inquiry"/></div></section>
<style>
  @font-face{font-family:'Vitaspace Pretendard';src:url('/fonts/PretendardVariable.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:swap}

  :global(body.home-word){--ink:#171717;--muted:#666;--line:#ddd;--mist:#f5f5f5;--lime:#e5e5e5;--deep:#171717;--word-font:'Vitaspace Pretendard','Apple SD Gothic Neo',sans-serif;font-family:var(--word-font);font-weight:400}
  :global(html:has(.home-word)){scroll-padding-top:85px}
  :global(.home-word .project-steps){font-family:var(--word-font)}
  :global(.home-word .project-steps h2){font-family:var(--word-font);font-weight:500}
  :global(.home-word aside a){font-family:var(--word-font)}
  :global(.home-word footer){background:#171717;padding-bottom:110px}
  @media(prefers-reduced-motion:reduce){:global(html:has(.home-word)){scroll-behavior:auto}}

  *{box-sizing:border-box}p,h2,h3,figure{margin:0}a{color:inherit;text-decoration:none}.detail-nav{position:sticky;top:0;z-index:30;background:#fff;border-top:1px solid #ddd;border-bottom:1px solid #ddd;display:flex;justify-content:center;gap:52px;padding:18px 24px;color:#171717;font-size:14px}.detail-nav a{padding:8px 0}.detail-nav a:last-child{border-bottom:1px solid #171717}.word-services,.word-brands,.word-contact{color:#171717;background:#fff;scroll-margin-top:0}.word-services{padding:100px clamp(24px,4.4vw,80px)}.word-services article{display:grid;grid-template-columns:1.2fr 1fr;gap:8vw;align-items:center}.word-services article+article{margin-top:110px}.word-services article:nth-child(even){grid-template-columns:1fr 1.2fr}.word-services article:nth-child(even) figure{grid-column:2;grid-row:1}.word-services article:nth-child(even)>div{grid-column:1;grid-row:1}.word-services figure{overflow:hidden;border-radius:18px}.word-services img{width:100%;height:clamp(340px,45vw,620px);object-fit:cover;display:block}.kicker{font:11px/1.4 Arial,sans-serif;letter-spacing:.13em;margin-bottom:28px}h2{font-family:var(--word-font);font-size:clamp(34px,3.7vw,56px);font-weight:500;line-height:1.4;letter-spacing:-.055em}.word-services h3{font-size:14px;font-weight:500;margin-top:32px}.description{font-size:15px;line-height:1.9;color:#666;margin-top:16px;max-width:28em}.word-services a,.word-brands a{display:inline-flex;gap:36px;border-bottom:1px solid #aaa;padding:14px 0;margin-top:26px;font-size:14px}.word-brands{display:grid;grid-template-columns:1fr 1.2fr;gap:8vw;align-items:center;padding:100px clamp(24px,4.4vw,80px);background:#f5f5f5}.word-brands p:not(.kicker){font-size:15px;line-height:1.9;color:#666;margin-top:26px}.brand-list{display:grid;grid-template-columns:1fr 1fr;gap:0 28px}.brand-list span{display:grid;place-items:center;height:100px;border-bottom:1px solid #ddd;font:600 clamp(18px,2vw,30px) Arial;letter-spacing:-.03em}.brand-list span:nth-last-child(-n+2){border:0}.brand-list span:last-child{font-size:18px}.word-contact{padding:110px clamp(24px,4.4vw,80px) 140px;display:grid;grid-template-columns:1fr 1fr;gap:7vw;border-top:1px solid #e3e3e3}.word-contact>div>p:not(.kicker){color:#666;font-size:15px;line-height:1.9;margin-top:28px}.contact-note{border-top:1px solid #ddd;display:flex;gap:24px;margin-top:52px;padding-top:26px;font-size:15px;line-height:1.8}.contact-note>span{font-size:28px}.contact-note small{display:block;color:#666;font-size:13px;margin-top:8px}.inquiry-panel{background:#f5f5f5;border-radius:18px;padding:34px}.inquiry-panel h3{font-size:23px;font-weight:500;margin-bottom:26px}.inquiry-panel :global(.word-inquiry){display:grid;grid-template-columns:1fr 1fr;gap:12px}.inquiry-panel :global(.field){box-sizing:border-box;width:100%;min-width:0;padding:15px 12px;border:1px solid #d8d8d8;border-radius:8px;background:#fff;color:#171717;line-height:1.4;font-family:inherit;font-size:14px}.inquiry-panel :global(.wide){grid-column:1/-1}.inquiry-panel :global(textarea){resize:vertical;min-height:110px}.inquiry-panel :global(.privacy){grid-column:1/-1;display:flex;align-items:start;gap:6px;font-size:11px;line-height:1.6;color:#666}.inquiry-panel :global(input[type=checkbox]){accent-color:#171717}.inquiry-panel :global(button[type=submit]){grid-column:1/-1;border:0;border-radius:8px;background:#171717;color:#fff;min-height:52px;font:inherit;font-size:15px;cursor:pointer;margin-top:8px}.inquiry-panel :global(.success){display:none;grid-column:1/-1;font-size:14px}.inquiry-panel :global(.field:focus-visible){outline:1px solid #333;outline-offset:1px}:is(a,button):focus-visible{outline:2px solid;outline-offset:4px}
  @media(max-width:760px){.detail-nav{gap:22px;font-size:12px;padding:12px 20px}.word-services{padding-top:64px;padding-bottom:64px}.word-services article,.word-services article:nth-child(even){display:flex;flex-direction:column;align-items:stretch;gap:28px}.word-services article+article{margin-top:72px}.word-services img{height:380px;max-height:55svh}.kicker{margin-bottom:20px}.word-services h3{margin-top:24px}.word-services a{margin-top:18px}.word-brands{grid-template-columns:1fr;gap:40px;padding-top:72px;padding-bottom:72px}.word-contact{grid-template-columns:1fr;gap:40px;padding-top:72px;padding-bottom:120px}.inquiry-panel{padding:24px 20px}.inquiry-panel :global(.field){font-size:16px;padding:14px 9px}.contact-note{margin-top:30px}.brand-list span{height:85px}}
</style>

---
import HomePage from '../../../components/HomePage.astro';
import { comparisonVersions } from '../../../data/comparison';

export function getStaticPaths() {
  return ['b', 'c', 'd', 'e', 'f'].map(version => ({ params: { version } }));
}

const { version } = Astro.params;
---

<HomePage focused={version === 'b'} editorial={version === 'c'} grid={version === 'd'} cinematic={version === 'e' || version === 'f' || version === 'g'} neighbor={version === 'f'} word={version === 'g'} preview>
  <div class="archive-notice">보관된 초기 {version?.toUpperCase()}안 · <a href="/compare/a/">현재 비교 화면으로 ↗</a></div>
  <aside aria-label="첫 화면 시안 비교">
    {comparisonVersions.map((item) => <a href={`/compare/${item.id}/`} >{item.label}</a>)}
  </aside>
</HomePage>

<style>
  .archive-notice{position:fixed;top:0;left:0;right:0;padding:8px 20px;background:#171717;color:#fff;z-index:150;font:12px/1.5 sans-serif;text-align:center}.archive-notice a{color:inherit;text-decoration:underline}
  aside {
    position: fixed;
    bottom: max(16px, env(safe-area-inset-bottom));
    right: max(16px, env(safe-area-inset-right));
    max-width: calc(100vw - 24px);
    overflow-x: auto;
    z-index: 101;
    display: flex;
    gap: 2px;
    padding: 4px;
    border: 1px solid #d0d0d0;
    border-radius: 32px;
    background: white;
    color: #171717;
    box-shadow: 0 3px 16px #10171824;
  }

  aside a {
    display: grid;
    place-items: center;
    min-height: 40px;
    white-space: nowrap;
    padding: 0 16px;
    border-radius: 24px;
    font: 600 14px/1.2 system-ui, sans-serif;
  }

  aside a[aria-current] {
    background: #171717;
    color: white;
  }
  @media (max-width: 640px) {
    aside {
      bottom: calc(68px + env(safe-area-inset-bottom));
    }
    aside a {
      padding: 0 10px;
      font-size: 12px;
    }
  }
</style>

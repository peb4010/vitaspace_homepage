---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaSection from '../components/CtaSection.astro';
import Card from '../components/Card.astro';
import BrandCard from '../components/BrandCard.astro';
import '../styles/detail.css';
---

<BaseLayout
  title="취급브랜드 | VITASPACE"
  description="퍼시스, 데스커, 시디즈, 베스툴, 파트라 등 공간과 예산에 맞춘 사무가구 브랜드 포트폴리오"
  activePath="brands"
>
  <PageHero eyebrow="Brand Portfolio" description="품질, 예산, 디자인, 납기와 요구 규격을 검토해 상용 브랜드와 맞춤 제작을 유연하게 조합합니다.">
    한 브랜드에 맞추지 않고,<br />공간에 맞춰 선택합니다.
  </PageHero>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="Office Furniture" description="프로젝트별 공급 가능 품목과 세부 조건은 상담 시 확인하며, 동일 공간 안에서도 브랜드를 조합할 수 있습니다.">
        주요 취급 브랜드
      </SectionHead>
      <div class="brand-grid">
        <BrandCard category="오피스 토털 솔루션" name="FURSYS" description="업무공간 · 회의공간 · 임원공간 · 수납" />
        <BrandCard category="스타트업·홈오피스" name="DESKER" description="데스크 · 모션데스크 · 회의가구 · 수납" />
        <BrandCard category="전문 좌석 솔루션" name="SIDIZ" description="업무용 · 회의용 · 교육용 의자" />
        <BrandCard category="인체공학 오피스체어" name="BESTUHL" description="업무용 · 회의용 · 조달 대응 의자" />
        <BrandCard category="오피스 시팅" name="PATRA" description="업무용 · 회의용 · 다목적 의자" />
        <BrandCard category="생활공간 가구" name="ILOOM" description="휴게 · 라운지 · 생활 연계 공간" />
        <BrandCard category="프리미엄 소파" name="ALLOSO" description="라운지 · 로비 · 접견공간" />
        <BrandCard category="현장 맞춤 제작" name="CUSTOM MADE" description="비규격 수납 · 테이블 · 붙박이 가구" />
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <SectionHead eyebrow="Selection Standard" description="제품 인지도만으로 결정하지 않고 실제 사용성과 사업 조건을 함께 검토합니다.">
        브랜드보다 먼저<br />조건을 비교합니다.
      </SectionHead>
      <div class="grid-3">
        <Card num="01" title="요구 규격" description="크기, 소재, 색상, 기능과 인증·납품 조건에 부합하는지 검토합니다." />
        <Card num="02" title="예산 효율" description="중요 공간과 일반 공간의 투자 우선순위를 나눠 총예산을 최적화합니다." />
        <Card num="03" title="납기·사후관리" description="필요 시점에 공급 가능한지와 추가 구매, 유지관리 편의성을 확인합니다." />
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <p class="quote">좋은 제안은 비싼 제품을 고르는 것이 아니라,<br /><em>맞는 제품을 정확히 고르는 일입니다.</em></p>
    </div>
  </section>

  <CtaSection label="비교 제안 요청하기 ↗">
    예산과 규격에 맞춘 브랜드 조합을 받아보세요.
  </CtaSection>
</BaseLayout>
